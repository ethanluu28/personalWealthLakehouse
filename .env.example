# Copy to .env and fill in. Never commit the real .env file.

# S3 bucket that holds bronze/silver/gold data
WEALTH_LAKEHOUSE_BUCKET=your-wealth-lakehouse

# Scoped IAM credentials (NOT root) — see README Step 2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Only needed if a stock API you use requires a key (yfinance does not)
STOCK_API_KEY=
