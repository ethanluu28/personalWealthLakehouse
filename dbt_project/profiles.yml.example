# Copy to ~/.dbt/profiles.yml and fill in. This is the piece that's still
# genuinely undecided (see README Step 3) — both options are sketched below,
# comment out the one you're not using.

wealth_lakehouse:
  target: dev
  outputs:

    # --- Option A: AWS Glue Data Catalog (try this first) -----------------
    dev:
      type: duckdb
      path: 'local.duckdb'
      extensions:
        - httpfs
        - iceberg
      settings:
        s3_region: "{{ env_var('AWS_REGION') }}"
        s3_access_key_id: "{{ env_var('AWS_ACCESS_KEY_ID') }}"
        s3_secret_access_key: "{{ env_var('AWS_SECRET_ACCESS_KEY') }}"
      attach:
        - path: "glue"
          type: iceberg
          # NOTE: duckdb's Glue catalog write support (v1.5+) is young —
          # if CREATE TABLE throws InvalidInputException or SigV4 auth
          # errors, switch to Option B below instead of debugging this
          # for too long.

    # --- Option B: self-hosted Lakekeeper (fallback) -----------------------
    # dev:
    #   type: duckdb
    #   path: 'local.duckdb'
    #   extensions:
    #     - httpfs
    #     - iceberg
    #   settings:
    #     s3_region: "{{ env_var('AWS_REGION') }}"
    #     s3_access_key_id: "{{ env_var('AWS_ACCESS_KEY_ID') }}"
    #     s3_secret_access_key: "{{ env_var('AWS_SECRET_ACCESS_KEY') }}"
    #   attach:
    #     - path: "http://localhost:8181/catalog"
    #       type: iceberg
    #       # standard OAuth2/REST auth against your local Lakekeeper container
